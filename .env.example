# ── Corteca / Nokia API ───────────────────────────────────────────────────────
# Nokia Corteca HomeWifi Edge API base URL
CORTECA_API_BASE_URL=https://l1api.demo2.homewifi.nokia.com

# OAuth client credentials (sent as headers, not query params)
CORTECA_CLIENT_ID=your-client-id
CORTECA_CLIENT_SECRET=your-client-secret

# ── Nokia Console URL (public — safe to expose to the browser) ────────────────
NEXT_PUBLIC_CORTECA_CONSOLE_URL=https://console.demo2.homewifi.nokia.com

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
#
# Neon console → project → Connect. The app reaches Neon through its serverless
# driver (WebSocket, port 443 — web/lib/prisma.ts) whenever this is a neon.tech URL.
# Drop "channel_binding=require" from the copied strings.
#
# Pooled connection (host has "-pooler") — used by the app at runtime
DATABASE_URL=postgresql://<user>:<password>@ep-<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15

# Direct connection — used only by "prisma db push" and seed scripts (Postgres
# protocol on port 5432, which some corporate networks block)
DIRECT_URL=postgresql://<user>:<password>@ep-<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# ── Site Gate ─────────────────────────────────────────────────────────────────
# Protects the entire app with a simple username/password gate before Corteca login.
# Leave unset to disable the gate in local development.
SITE_USERNAME=your-gate-username
SITE_PASSWORD=your-gate-password
