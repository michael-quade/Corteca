datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled (PgBouncer) — used at runtime
  directUrl = env("DIRECT_URL")         // direct connection — used by prisma db push / migrate
}

generator client {
  provider = "prisma-client-js"
}

model SwMatrix {
  id           Int      @id @default(1)
  beaconModels Json     @default("[]") @map("beacon_models")
  releases     Json     @default("[]")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sw_matrix")
}

model ApiSession {
  id            String    @id
  startTime     DateTime  @map("start_time")
  endTime       DateTime? @map("end_time")
  calls         Int       @default(0)
  bytesSent     Int       @default(0) @map("bytes_sent")
  bytesReceived Int       @default(0) @map("bytes_received")
  rateLimitHits Int       @default(0) @map("rate_limit_hits")

  @@map("api_sessions")
}
