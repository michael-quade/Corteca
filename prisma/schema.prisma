datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled (PgBouncer) — used at runtime
  directUrl = env("DIRECT_URL")         // direct connection — used by prisma db push / migrate
}

generator client {
  provider = "prisma-client-js"
}

model SwMatrix {
  id           Int      @id @default(1)
  beaconModels Json     @default("[]") @map("beacon_models")
  releases     Json     @default("[]")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("sw_matrix")
}

model DeploymentReport {
  id       Int      @id @default(1)
  devices  Json     @default("[]")
  headers  Json     @default("[]")
  rawRows  Json     @default("[]")  @map("raw_rows")
  stats    Json     @default("{}")
  uspMap   Json     @default("{}") @map("usp_map")
  cachedAt DateTime @map("cached_at")

  @@map("deployment_report")
}

model ApiSession {
  id            String    @id
  startTime     DateTime  @map("start_time")
  endTime       DateTime? @map("end_time")
  calls         Int       @default(0)
  bytesSent     Int       @default(0) @map("bytes_sent")
  bytesReceived Int       @default(0) @map("bytes_received")
  rateLimitHits Int       @default(0) @map("rate_limit_hits")

  @@map("api_sessions")
}

// Ethernet port layout per device model, learned from gateways' live TR-181 ports
// (mesh Beacons don't report theirs). Keyed by modelKey(): "beacon 10".
model PortLayout {
  model           String   @id
  displayName     String   @map("display_name")
  hardwareVersion String   @default("") @map("hardware_version")
  ports           Json     @default("[]")
  source          String   @default("live")
  sampleMac       String   @default("") @map("sample_mac")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("port_layouts")
}
